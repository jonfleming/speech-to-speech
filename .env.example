# speech-to-speech: secrets for server-side MCP tools (mcp_servers.json).
# Copy to .env next to mcp_servers.json (or set these as environment variables).
# Never commit the real .env. Values here are placeholders.

# Google Calendar + Gmail via workspace-mcp (Google Cloud "Desktop app" OAuth client)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# The Google account to read/write. workspace-mcp stores its token for this account
# under %USERPROFILE%\.google_workspace_mcp\credentials after the first sign-in.
GOOGLE_USER_EMAIL=you@gmail.com

# Todoist via the official Todoist MCP server (@todoist/mcp)
# Todoist web: Settings > Integrations > Developer > API token
TODOIST_API_KEY=your-todoist-api-token

# Optional: path to the MCP config if you don't pass --mcp_config
# S2S_MCP_CONFIG=C:\Projects\ai-voice-assistant\speech-to-speech\mcp_servers.json
